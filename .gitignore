# ============================================================
# bklyn-threads — standalone project gitignore
# Does NOT share anything with the pairtalk repo.
# ============================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js build output
.next/
out/
build/
dist/

# Env / secrets — never commit real credentials
.env
.env.local
.env*.local

# Prisma
prisma/dev.db
prisma/dev.db-journal

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
Thumbs.db

# Runtime
next-env.d.ts
tsconfig.tsbuildinfo
*.tsbuildinfo

# uploaded assets (keep the dir structure)
public/uploads/*
!public/uploads/.gitkeep
