# ============================================================
# bklyn-threads — environment template
# Copy this file to `.env` (or set these vars on Railway) and
# fill in real values. Never commit your real `.env`.
# ============================================================

# --- Database (PostgreSQL on Railway) ---
# Local example: postgresql://postgres:postgres@localhost:5432/bklyn_threads
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/bklyn_threads"

# --- NextAuth ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-generate-a-random-base64-secret"
# Public site URL for callbacks (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"

# --- Admin password-only login -------------------------------
# /login asks for a password only (no email). It is checked against
# ADMIN_PASSWORD and provisions/updates the ADMIN account in the DB
# on every successful login. Email+password logins still work too.
# The committed fallbacks in src/lib/auth.ts match prisma/seed.cjs —
# set both env vars on Railway when you rotate the password.
ADMIN_EMAIL="admin@jayfab.org"
ADMIN_PASSWORD="change-me-admin-password"

# --- Stripe Checkout -----------------------------------------
# Stripe dashboard -> Developers -> API keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."