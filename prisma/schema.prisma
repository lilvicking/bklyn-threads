// bklyn-threads Prisma schema
// PostgreSQL. Manage with: npm run db:push / db:migrate / db:studio

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// Catalog
// ------------------------------------------------------------
enum Category {
  TEES
  OUTERWEAR
  HEADWEAR
  FOOTWEAR
  ACCESSORIES
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Collection {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  products    Product[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String?
  category    Category
  status      ProductStatus @default(DRAFT)
  basePrice   Int // cents, tax-exclusive
  images      ProductImage[]
  variants    Variant[]
  collection  Collection?   @relation(fields: [collectionId], references: [id])
  collectionId String?
  orderItems  OrderItem[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  alt       String?
  position  Int     @default(0) // ordering within the gallery
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
}

model Variant {
  id        String   @id @default(cuid())
  sku       String   @unique
  size      String?
  color     String?
  priceAdj  Int      @default(0) // price delta in cents
  stock     Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  orderItems OrderItem[]
}

// ------------------------------------------------------------
// Users & Auth
// ------------------------------------------------------------
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  role          Role      @default(CUSTOMER)
  orders        Order[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum Role {
  CUSTOMER
  ADMIN
  STAFF
}

// ------------------------------------------------------------
// Orders
// ------------------------------------------------------------
enum OrderStatus {
  PENDING
  UNFULFILLED
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id           String        @id @default(cuid())
  status       OrderStatus   @default(UNFULFILLED)
  stripeId     String?       @unique
  subtotal     Int
  shipping     Int           @default(0)
  total        Int
  items        OrderItem[]
  user         User?         @relation(fields: [userId], references: [id])
  userId       String?
  shippingName String?
  shippingLine1 String?
  shippingCity String?
  shippingPostal String?
  shippingCountry String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model OrderItem {
  id         String    @id @default(cuid())
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String
  product    Product   @relation(fields: [productId], references: [id])
  productId  String
  variant    Variant?  @relation(fields: [variantId], references: [id])
  variantId  String?
  unitPrice  Int
  quantity   Int
}